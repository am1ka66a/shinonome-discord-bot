# 本機設定；請將此檔複製為 .env 後在電腦上填寫，不要貼到聊天或提交到 Git。
DISCORD_TOKEN=

# 連接 Railway 原資料庫時，填 MySQL 的公開 TCP Proxy 主機及對外連接埠。
# 不要填僅限 Railway 內網使用的 *.railway.internal。
MYSQLHOST=
MYSQLPORT=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLDATABASE=

DISCORD_MEMBERS_INTENT=true

# /ask 測試功能。使用專用 OpenClaw Gateway，並填入測試伺服器、頻道及使用者 ID。
SHINONOME_AI_ENABLED=false
SHINONOME_AI_GUILD_ID=
SHINONOME_AI_CHANNEL_ID=
SHINONOME_AI_USER_ID=
SHINONOME_AI_GATEWAY_URL=
SHINONOME_AI_GATEWAY_TOKEN=
